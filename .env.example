# 本地开发模板；生产环境必须通过安全配置注入强随机密钥。
APP_ENV=development
APP_NAME=智邻管家
DATABASE_URL=sqlite:///./data/zhilin.db
# demo = synthetic local tenant data; public_real = staff-only historical public data.
DATA_MODE=demo
PUBLIC_REAL_QUERY_LIMIT=100
JWT_SECRET=change-this-to-a-random-32-byte-minimum-secret
TOKEN_EXPIRE_MINUTES=480
DEMO_PASSWORD=DemoPass123!
LOG_LEVEL=INFO
RAG_ENABLED=true
RAG_STORAGE_PATH=data/knowledge/files
RAG_CHROMA_PATH=data/knowledge/chroma_beijing_v1
RAG_COLLECTION_PREFIX=property_kb
RAG_INDEX_SCHEMA_VERSION=2
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVAL_TOP_K=5
RAG_SCORE_THRESHOLD=0.12
RAG_FINAL_CONTEXT_K=5
RAG_HYBRID_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RRF_K=60
RAG_CANDIDATE_K=40
# Hashing is deterministic offline fallback.  Use openai_compatible in production.
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=hashing-v1
RAG_EMBEDDING_API_BASE=
RAG_EMBEDDING_API_KEY=
# Optional HTTP reranker. "lexical" is the deterministic offline fallback;
# configure "http" plus a /rerank-compatible endpoint for formal evaluation.
RAG_RERANKER_PROVIDER=lexical
RAG_RERANKER_MODEL=lexical-v1
RAG_RERANKER_API_BASE=
RAG_RERANKER_API_KEY=
RAG_RERANKER_TIMEOUT_SECONDS=30
# Optional answer-generation provider. Retrieval-only cited answers work without it.
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_LLM_API_BASE=
RAG_LLM_API_KEY=
RAG_QUERY_LOG_RETENTION_DAYS=180
MAX_KNOWLEDGE_FILE_SIZE_MB=10
AGENT_ENABLED=true
AGENT_LLM_PROVIDER=fake
AGENT_LLM_MODEL=
AGENT_LLM_API_BASE=
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_RETRIES=1
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_FOLLOW_UP_ROUNDS=3
AGENT_CONFIRMATION_TTL_MINUTES=30
AGENT_LONG_TERM_MEMORY_ENABLED=true
AGENT_CHECKPOINT_PATH=data/agent_checkpoints.sqlite
MCP_ENABLED=true
MCP_SERVER_NAME=property-community-agent
MCP_SERVER_VERSION=1.3.0-remediation
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8011
# stdio/Inspector can only use this strict development identity. Never enable it in production.
MCP_DEV_AUTH_ENABLED=false
MCP_DEV_USER_ID=
MCP_DEV_SESSION_TOKEN=
MCP_DEV_WRITE_CONFIRMED=false
AGENT_TOOL_BACKEND=local
MCP_CLIENT_ENABLED=false
MCP_CLIENT_TRANSPORT=stdio
MCP_CLIENT_COMMAND=
MCP_CLIENT_URL=
MCP_CLIENT_TIMEOUT_SECONDS=15
MCP_ALLOW_LOCAL_FALLBACK=false
HARNESS_ENABLED=true
HARNESS_DEFAULT_TIMEOUT_SECONDS=15
HARNESS_READ_RETRIES=1
HARNESS_CIRCUIT_FAILURE_THRESHOLD=3
HARNESS_CIRCUIT_RESET_SECONDS=30
# Test-only, rejected outside test environment: transient_read_once|unknown_after_write
HARNESS_FAILURE_INJECTION=
# Stage 6 pilot. Keep false until an authorized, read-only pilot has been approved.
STAGE6_READONLY_INTEGRATION_ENABLED=false
PROPERTY_SYSTEM_ADAPTER=demo
PROPERTY_SYSTEM_DEMO_DATA_PATH=data/external_reference/demo_property_work_orders.json
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
