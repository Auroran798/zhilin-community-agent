# Emergency local-only rebuild when Docker Hub is temporarily unreachable.
# It deliberately reuses a previously built project image, then replaces the
# application source. Standard CI and normal deployments must use Dockerfile.
FROM zhilin-community-agent-api:latest
WORKDIR /app
USER root
COPY --chown=zhilin:zhilin . .
RUN python3 -m pip install --no-cache-dir --retries 3 --timeout 60 .
USER zhilin
CMD ["uvicorn","api.main:app","--host","0.0.0.0","--port","8000"]
